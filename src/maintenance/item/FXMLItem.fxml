<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="683.0" prefWidth="975.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="maintenance.item.FXMLItemController">
    <stylesheets>
        <URL value="@fxmlitem.css" />
    </stylesheets>
   <children>
      <ImageView fitHeight="343.0" fitWidth="331.0" layoutX="362.0" layoutY="34.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../img/seller.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="346.0" fitWidth="888.0" layoutX="8.0" layoutY="323.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../img/stall.png" />
         </image>
      </ImageView>
      <TableView fx:id="tbitem" layoutX="62.0" layoutY="442.0" onMouseClicked="#gambar_desc" prefHeight="179.0" prefWidth="451.0">
        <columns>
          <TableColumn prefWidth="69.0" text="C1" />
          <TableColumn prefWidth="81.0" text="C2" />
        </columns>
      </TableView>
      <ImageView fx:id="itemimg" fitHeight="129.0" fitWidth="152.0" layoutX="688.0" layoutY="228.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../img/amul.png" />
         </image>
      </ImageView>
      <Button fx:id="prev" layoutX="757.0" layoutY="442.0" mnemonicParsing="false" onAction="#prevclick" prefHeight="56.0" prefWidth="60.0" styleClass="inv-btn">
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" rotate="-90.0">
               <image>
                  <Image url="@../../img/next.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="next" layoutX="757.0" layoutY="571.0" mnemonicParsing="false" onAction="#nextclick" prefHeight="50.0" prefWidth="60.0" styleClass="inv-btn">
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" rotate="90.0">
               <image>
                  <Image url="@../../img/next.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="back" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#backclick" text="Back" />
      <Button fx:id="add" layoutX="62.0" layoutY="630.0" mnemonicParsing="false" onAction="#addclick" text="Add" />
      <Button fx:id="edit" layoutX="134.0" layoutY="630.0" mnemonicParsing="false" onAction="#editclick" text="Edit" />
      <Button fx:id="remove" layoutX="201.0" layoutY="630.0" mnemonicParsing="false" onAction="#removeclick" text="x" />
      <TextField fx:id="find" layoutX="62.0" layoutY="395.0" onKeyTyped="#searchitm" prefHeight="39.0" prefWidth="649.0" promptText="search item by name or Ids" />
      <TextArea fx:id="txdesc" editable="false" layoutX="534.0" layoutY="442.0" prefHeight="179.0" prefWidth="223.0" wrapText="true" />
      <Button layoutX="714.0" layoutY="395.0" mnemonicParsing="false" onAction="#searchclick" prefHeight="39.0" prefWidth="43.0" text="🔍" />
   </children>
</AnchorPane>
