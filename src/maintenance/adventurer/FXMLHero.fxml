<AnchorPane id="AnchorPane" prefHeight="616.0" prefWidth="1250.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="maintenance.adventurer.FXMLHeroController">
    <stylesheets>
        <URL value="@fxmlhero.css" />
